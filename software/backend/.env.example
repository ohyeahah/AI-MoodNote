# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 깃에 올리지 않습니다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=moodnote_app
DB_PASSWORD=
DB_NAME=moodnote

# 아래 두 값은 직접 만들어서 넣습니다.
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# 쉼표로 여러 개 가능. 웹 화면이 뜨는 주소를 적습니다.
CORS_ORIGINS=http://localhost:3000

# ---- 소셜 로그인 (카카오 / 네이버 / 구글). 비워 두면 그 버튼은 "준비 중"으로 보입니다. ----
# 서비스 주소. 끝에 / 를 붙이지 않습니다. 각 업체에 등록한 Redirect URI 의 앞부분과 똑같아야 합니다.
PUBLIC_BASE_URL=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
